    {
      "parameters": {
        "jsCode": "const src = $input.first().json;\nconst raw = String(src.text ?? src.output ?? '');\nlet out = null;\ntry {\n  const p = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1));\n  const pr = typeof p.priority === 'string' ? p.priority.trim().toLowerCase() : '';\n  const prio = pr === 'hot' ? 'Hot' : pr === 'warm' ? 'Warm' : pr === 'cold' ? 'Cold' : '';\n  if (prio && typeof p.reason === 'string' && typeof p.is_spam === 'boolean') {\n    out = { priority: prio, reason: p.reason.replace(/[\\r\\n\"]/g, ' ').slice(0, 140), is_spam: p.is_spam, classifier_failed: false };\n  }\n} catch (e) {}\nif (!out) out = { priority: 'Warm', reason: 'AI classification failed; manual review', is_spam: false, classifier_failed: true };\nreturn [{ json: out }];"
      },
