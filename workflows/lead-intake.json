    {
      "parameters": {
        "jsCode": "const r = $input.first().json.body ?? $input.first().json;\nconst hdr = ($input.first().json.headers || {})['x-intake-key'];\nconst cfgKey = String($('Config').first().json.INTAKE_KEY || '');\nconst authorized = cfgKey.length >= 16 && hdr === cfgKey;\nconst s = v => String(v ?? '').trim();\nconst name = s(r.name).replace(/[ ]+/g, ' ').slice(0, 120);\nconst email = s(r.email).toLowerCase().slice(0, 254);\nconst emailValid = /^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$/.test(email);\nconst rawPhone = s(r.phone).slice(0, 40);\nconst digits = rawPhone.replace(/[^0-9]/g, '');\nlet phone = '';\nif (rawPhone.startsWith('+') && digits.length >= 8 && digits.length <= 15) phone = '+' + digits;\nelse if (digits.length === 10) phone = '+1' + digits;\nelse if (digits.length === 11 && digits[0] === '1') phone = '+' + digits;\nconst rawMsg = s(r.message).replace(/<<<|>>>/g, '');\nconst source = s(r.source).toLowerCase().slice(0, 60) || 'unknown';\nconst now = Date.now();\nconst empty = !name && !email;\nconst reason = !authorized ? 'unauthorized' : (empty ? 'empty' : '');\nreturn [{ json: { lead_id: `${$execution.id}-${now}`, timestamp: new Date(now).toISOString(), name, email, emailValid, phone, message: rawMsg.slice(0, 2000), message_truncated: rawMsg.length > 2000, source, rejected: !authorized || empty, reject_reason: reason } }];"
      },
